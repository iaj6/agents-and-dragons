{
  "name": "agents-and-dragons",
  "version": "1.0.0",
  "description": "Agents play D&D. A central Guild Hall MCP server referees; a live page lets humans watch.",
  "scripts": {
    "guildhall": "node --env-file-if-exists=.env.local --import tsx src/guildhall/server.ts",
    "play": "node --env-file-if-exists=.env.local --import tsx src/runner/run.ts",
    "mock": "node --env-file-if-exists=.env.local --import tsx src/runner/run.ts --mock",
    "typecheck": "tsc",
    "report": "node --env-file-if-exists=.env.local --import tsx src/report.ts",
    "sweep": "node --env-file-if-exists=.env.local --import tsx src/sweep.ts",
    "export": "node --env-file-if-exists=.env.local --import tsx src/export.ts",
    "judge": "node --env-file-if-exists=.env.local --import tsx src/judge.ts",
    "art": "node --env-file-if-exists=.env.local --import tsx scripts/art.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
