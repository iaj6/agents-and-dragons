# Copy to .env.local and fill in what you have. You need one of the first two to play with real models.
# With no keys at all, `npm run mock` plays a scripted table for free.

# Vercel AI Gateway: any vendor's models (Claude, GPT, Gemini, Qwen...) and image generation for `npm run art`.
# If set, all model calls go through the Gateway. Create one with: vercel ai-gateway api-keys create --budget 25
AI_GATEWAY_API_KEY=

# Or the Anthropic API directly (Claude models only). Used when AI_GATEWAY_API_KEY is empty,
# or when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
